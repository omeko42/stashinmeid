# ============================================================
# Environment variables untuk Vercel (Production)
# ============================================================
#
# CARA PAKAI
# ---------
# Di Vercel: Project stashinmeid > Settings > Environment Variables
# Tambahkan satu per satu, pilih "Secret" (kecuali NEXT_PUBLIC_*).
# Pastikan "Environments" = Production.
#
# Semua nilai di bawah berasal dari project Supabase BARU.
# Ambil dari: Supabase > Project Settings > API
#
# CATATAN PENTING
# ---------------
# Env var ini menggantikan yang lama. Project Supabase lama
# (kzsibutamqrdshimdykv) SUDAH DIHAPUS - kalau masih dipakai, semua API
# akan 401/500 dan halaman jatuh ke data contoh.
# ============================================================

# --- Supabase (wajib) ---

# Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://zykqeucsrldzvzxmyplq.supabase.co

# Project Settings > API > Publishable key / anon public key
# (aman dipublikasikan - memang dikirim ke browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inp5a3FldWNzcmxkenZ6eG15cGxxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTUyNDIxODAsImV4cCI6MjExMDgxODE4MH0.zlH9Inwq0x6n1VQP4Trplg6bSf2pnp214E1xMsjndnc

# Project Settings > API > Secret key / service_role key
# JANGAN pernah dipublikasikan. Dipakai untuk operasi admin
# (baca semua user, impersonate, tulis lewat API).
SUPABASE_SERVICE_ROLE_KEY=<paste-dari-supabase>

# --- Superadmin (wajib untuk login dashboard) ---

# Username yang dipakai untuk login superadmin (tanpa "@")
SUPERADMIN_USERNAME=omeko42

# Password superadmin. Alternatif yang lebih aman: pakai
# SUPERADMIN_PASSWORD_HASH dan hapus baris ini.
# Generate hash: npm run hash-password -- "password-anda"
SUPERADMIN_PASSWORD=<password-superadmin-lu>

# Email user Supabase milik superadmin. Opsional - kalau kosong, app
# membuat sendiri dari <SUPERADMIN_USERNAME>@stashinmeid.id
# SUPERADMIN_EMAIL=

# --- Keamanan (wajib) ---

# Kunci tanda tangan token session. Minimal 32 karakter.
# Generate: openssl rand -base64 48
# PENTING: kalau diganti, semua session superadmin yang sedang aktif
# jadi tidak valid dan user harus login ulang.
JWT_SECRET=<minimal-32-karakter>

# --- Opsional / Integrasi Pihak Ketiga ---

# Dipakai fitur "Pindai struk dengan AI" (scan receipt).
# Tanpa ini, fitur tersebut akan mengembalikan error.
GEMINI_API_KEY=

# Email transaksional Resend (noreply@stashinme.biz.id)
RESEND_API_KEY=

# Notifikasi Telegram Bot (@stashinmeid_bot)
TELEGRAM_BOT_TOKEN=

# PayPal Checkout (Global USD)
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Midtrans (Indonesia IDR)
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=

# --- Cloudflare Turnstile (captcha login) ---
#
# Wajib di production. Tanpa ini, login tidak dilindungi captcha.
# Ambil dari Dashboard Cloudflare > Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# URL publik utama aplikasi untuk metadata/OG & callback
NEXT_PUBLIC_SITE_URL=https://stashinme.biz.id
