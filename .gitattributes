# Normalisasi line ending - mencegah seluruh file jadi diff raksasa
# hanya karena perbedaan CRLF vs LF.
* text=auto eol=lf

# Binary: jangan pernah disentuh
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary

# Lockfile: biarkan apa adanya
package-lock.json -diff
