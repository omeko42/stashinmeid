# Supabase Configuration
#
# URL dan anon key TIDAK perlu diset di hosting - nilainya sudah ada di
# src/lib/supabase/project.ts (aman di-commit, keduanya memang publik).
# Env var di sini hanya sebagai override kalau lu mau pakai project lain.
#
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Ref project Supabase (dipakai script sync-vercel-env).
SUPABASE_PROJECT_REF=your-project-id

# Service role key untuk operasi admin (membaca semua user, impersonate).
# WAJIB disimpan sebagai secret - jangan pernah di-commit atau ditaruh di
# variabel NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Token personal Vercel, untuk script scripts/sync-vercel-env.mjs.
# Dibuat di: Vercel > Settings > Account > Tokens
# Dipakai supaya ganti project Supabase cukup satu perintah, bukan set
# manual tiap variable di dashboard Vercel.
VERCEL_TOKEN=your-vercel-token

# Opsional: ID team Vercel (kalau project berada di dalam team).
# VERCEL_TEAM_ID=

# Google Gemini API Key (for lightweight AI receipt/transfer image scanning)
GEMINI_API_KEY=your-gemini-api-key

# JWT signing secret - WAJIB. Minimal 32 karakter.
# Generate: openssl rand -base64 48
# JANGAN sama dengan password, dan JANGAN pernah di-commit.
JWT_SECRET=your-jwt-secret-minimum-32-characters

# Superadmin (optional, set in .env.local and Vercel Env Vars - NEVER commit real values)
SUPERADMIN_USERNAME=your-superadmin-username

# Password superadmin. Pilih salah satu:
#
# Opsi 1 (disarankan) - hash. Generate dengan:
#   npm run hash-password -- "password-anda"
# lalu salin hasilnya ke SUPERADMIN_PASSWORD_HASH.
SUPERADMIN_PASSWORD_HASH=salt-hex:hash-hex

# Opsi 2 (mode lama, kurang aman) - password polos.
# Kalau baris ini diisi, SUPERADMIN_PASSWORD_HASH diabaikan.
# SUPERADMIN_PASSWORD=your-superadmin-password
